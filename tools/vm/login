#!/usr/bin/env bash
# Warten bis die VM bereit ist, am Anmeldebildschirm anmelden, warten bis der Desktop da ist.
T="$(cd "$(dirname "$0")" && pwd)"
for i in $(seq 60); do "$T/vssh" true 2>/dev/null && break; sleep 3; done
for i in $(seq 30); do "$T/vssh" 'pgrep -f plasmalogin-greeter >/dev/null || pgrep -x plasmalogin >/dev/null' 2>/dev/null && break; sleep 2; done
sleep 6
"$T/vm" key KEY_LEFTSHIFT; sleep 2
"$T/vm" type "${VMPASS:-testpass1234}
"
for i in $(seq 40); do "$T/vssh" 'pgrep -u "$(id -u)" -x plasmashell >/dev/null' 2>/dev/null && break; sleep 2; done
# warten, bis der Startbildschirm (schwarz) weg ist
for i in $(seq 30); do
    "$T/vm" shot >/dev/null 2>&1
    m=$(magick "${XDG_RUNTIME_DIR:-/tmp}/easylinux-vm/vm.png" -format '%[fx:mean]' info: 2>/dev/null || echo 0)
    awk "BEGIN{exit !($m>0.1)}" && break; sleep 3
done
"$T/vssh" "printf '#!/bin/sh\necho ${VMPASS:-testpass1234}\n' > ~/.askpass; chmod 700 ~/.askpass"
"$T/vssh" "kwriteconfig6 --file kscreenlockerrc --group Daemon --key Autolock false; kwriteconfig6 --file powerdevilrc --group AC --group Display --key TurnOffDisplayWhenIdle false; loginctl unlock-sessions" 2>/dev/null
"$T/vm" mouse-start
echo "angemeldet"
