#!/bin/sh
# easyLinux: KDE-Einstellungsseiten, die easyLinux selbst zeigt, im easyLinux-Fenster öffnen
# (Startmenü-Suche, Rechtsklick auf Uhr/Lautstärke/Netzwerk …). Alles andere wie gewohnt.
for a in "$@"; do case "$a" in -*) ;; *) kcm="$a"; break ;; esac; done
if [ -n "${kcm:-}" ] && [ -x /opt/easylinux/bin/easylinux-settings ] \
        && python3 /opt/easylinux/apps/settings/route.py "$kcm" 2>/dev/null; then
    exec /opt/easylinux/bin/easylinux-settings "$(basename "$kcm" .desktop)"
fi
exec /usr/bin/systemsettings "$@"
